lt\n","\n","def chip_id(token):\n","    # works for \"76868\", \"76868_image.tif\", etc.\n","    return token.replace(\".tif\", \"\").replace(\"_image\", \"\").replace(\"_label\", \"\")\n","\n","def load_pair(cid):\n","    with rasterio.open(f\"{IMG_DIR}/{cid}_image.tif\") as s:\n","        img = s.read()[4:6]          # bands 5,6 -> VV, VH (0-indexed 4:6)\n","    with rasterio.open(f\"{LBL_DIR}/{cid}_label.tif\") as s:\n","        lbl = s.read(1)\n","    return img, lbl\n","\n","def stretch(band):\n","    lo, hi = np.percentile(band, [2, 98])\n","    return np.clip((band - lo) / (hi - lo + 1e-6), 0, 1)\n","\n","train_ids = [chip_id(t) for t in open(f\"{SPLIT_DIR}/train.txt\").read().split()]\n","\n","fig, axes = plt.subplots(5, 3, figsize=(10, 16))\n","for row, cid in enumerate(train_ids[:5]):\n","    img, lbl = load_pair(cid)\n","    axes[row, 0].imshow(stretch(img[0]), cmap=\"gray\"); axes[row, 0].set_title(f\"{cid} VV\")\n","    axes[row, 1].imshow(stretch(img[1]), cmap=\"gray\"); axes[row, 1].set_title(\"VH\")\n","    axes[row, 2].imshow(lbl, cmap=\"viridis\", vmin=-1, vmax=1); axes[row, 2].set_title(\"label (-1/0/1)\")\n","    for a in axes[row]: a.axis(\"off\")\n","plt.tight_layout(); plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Hjf03_VEH4pX","executionInfo":{"status":"ok","timestamp":1791053868417,"user_tz":-330,"elapsed":3120,"user":{"displayName":"Ishita Kawadkar","userId":"05232686559204698169"}},"outputId":"503faa62-4ce7-4e28-a358-f730f6202f9f"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x1600 with 15 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["for cid in train_ids[:5]:\n","    _, lbl = load_pair(cid)\n","    print(cid, \"no-data:\", (lbl==-1).mean().round(2), \"flood:\", (lbl==1).mean().round(3))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Ps0aT1UDJ1dg","executionInfo":{"status":"ok","timestamp"